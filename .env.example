# Copy to .env (git-ignored) for local runs. Never commit real values.
# Names mirror the Parameter Store secrets: /canvas-reminder/<name> -> CANVAS_REMINDER_<NAME>.

# Canvas -> Calendar -> "Calendar Feed". Treat it like a password.
CANVAS_REMINDER_ICS_URL=

# JSON, e.g. {"topic": "your-long-random-topic"}  (optionally "token" for a protected topic)
CANVAS_REMINDER_NTFY=

# Written by scripts/google_auth.py --dotenv
CANVAS_REMINDER_GOOGLE=

# Written by scripts/ms_auth.py --dotenv
CANVAS_REMINDER_MICROSOFT=

# State table for local runs (e.g. LocalStack: http://localhost:4566)
TABLE_NAME=canvas-reminder-local
DYNAMODB_ENDPOINT_URL=
AWS_DEFAULT_REGION=ap-southeast-2
